# Copy to .env.prod and fill in before: docker compose --env-file .env.prod -f docker-compose.prod.yml up -d

# Required — use the full commit SHA published by the CD workflow (not "latest")
IMAGE_TAG=replace_with_full_git_sha_from_cd

# Required secrets (generate strong random values)
POSTGRES_PASSWORD=replace_me
SECRET_KEY=replace_me_with_a_long_random_string

